#!/bin/sh
# Pengaman lokal SiTangkap: menolak push langsung ke main, dev, dan master.
# Aktifkan sekali per clone:  git config core.hooksPath .githooks
# Panduan: docs/03-git-workflow.md
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/dev|refs/heads/master)
      echo "" >&2
      echo "DITOLAK: dilarang push langsung ke ${remote_ref#refs/heads/}." >&2
      echo "Buat branch tugas dari dev (contoh: backend/rafli-b07-login-sesi) lalu buka pull request ke dev." >&2
      echo "Terlanjur commit di dev/main? Lihat docs/03-git-workflow.md bagian 7." >&2
      echo "" >&2
      exit 1
      ;;
  esac
done
exit 0
